{
  "version": 1,
  "light": {
    "background-base": "#F9F9F9",
    "background-pane": "#FFFFFF",
    "background-input": "#FFFFFF",
    "background-input-focus": "#FAFAFA",
    "text-main": "#111111",
    "text-muted": "#454545",
    "text-inverse": "#111111",
    "text-accent": "#166534",
    "border-color-heavy": "#111111",
    "shadow-color": "#111111",
    "line-soft": "#D8D8D8",
    "accent-green": "#39FF14",
    "accent-green-hover": "#2ee60b",
    "accent-green-deep": "#166534",
    "surface-accent": "var(--accent-green)",
    "font-ui": "\"Space Grotesk\", ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
    "font-code": "\"Fira Code\", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", monospace",
    "font-xs": "11px",
    "font-sm": "13px",
    "font-base": "15px",
    "font-lg": "16px",
    "font-xl": "24px",
    "font-xxl": "28px",
    "weight-regular": "400",
    "weight-medium": "500",
    "weight-bold": "700",
    "border-width-heavy": "3px",
    "border-width-standard": "2px",
    "border-width-light": "1px",
    "shadow-hard": "4px 4px 0 var(--shadow-color)",
    "shadow-hard-hover": "2px 2px 0 var(--shadow-color)",
    "shadow-glow-active": "4px 4px 0 rgba(57, 255, 20, 0.2)",
    "bg-color": "var(--background-base)",
    "pane-bg": "var(--background-pane)",
    "input-focus": "var(--background-input-focus)",
    "border-color": "var(--border-color-heavy)",
    "border-heavy": "var(--border-color-heavy)",
    "line": "var(--border-color-heavy)",
    "surface": "var(--background-pane)",
    "muted": "var(--text-muted)",
    "ink": "var(--text-main)",
    "blue": "#2459D6",
    "green": "var(--text-accent)",
    "amber": "#8A4D00",
    "red": "#B42318",
    "teal-soft": "#EAFBE6",
    "blue-soft": "#EEF4FF",
    "amber-soft": "#FFF4DB",
    "red-soft": "#FFF0ED",
    "elevation-sm": "var(--shadow-hard)",
    "elevation-md": "var(--shadow-hard)",
    "tab-active-background": "var(--accent-green)",
    "tab-active-border": "var(--accent-green)",
    "tab-active-text": "var(--text-inverse)",
    "tab-inactive-background": "transparent",
    "tab-inactive-hover-background": "var(--background-input-focus)",
    "tab-inactive-text": "var(--text-muted)",
    "badge-dot-size": "0.5rem",
    "radius-sm": "6px",
    "radius-panel": "20px",
    "agent-surface": "var(--background-pane)",
    "agent-overlay": "var(--background-pane)",
    "agent-highlight": "var(--accent-green)",
    "agent-glow": "rgba(57,255,20,.16)",
    "agent-secondary": "var(--text-accent)",
    "agent-motion": "180ms",
    "agent-panel-width": "480px",
    "font-agent": "\"Courier Prime\", \"Courier New\", monospace",
    "agent-paper": "var(--background-pane)",
    "agent-ink": "var(--text-main)",
    "agent-paper-muted": "var(--text-muted)",
    "agent-paper-line": "var(--line-soft)",
    "agent-paper-margin": "var(--line-soft)",
    "agent-mark": "var(--teal-soft)",
    "agent-mark-ink": "var(--text-main)",
    "agent-machine": "var(--accent-green)",
    "agent-machine-trim": "#456555",
    "agent-key": "var(--accent-green)",
    "agent-key-ink": "var(--text-inverse)",
    "agent-stamp": "var(--text-accent)",
    "agent-machine-ink": "var(--text-inverse)",
    "agent-control-line": "var(--border-color-heavy)"
  },
  "dark": {
    "background-base": "#0A0A0A",
    "background-pane": "#141414",
    "background-input": "#0A0A0A",
    "background-input-focus": "#1A1A1A",
    "text-main": "#F9F9F9",
    "text-muted": "#C2C2C2",
    "text-inverse": "#111111",
    "text-accent": "var(--accent-green)",
    "border-color-heavy": "#777777",
    "shadow-color": "#333333",
    "line-soft": "#242424",
    "blue": "#8BB7FF",
    "amber": "#FFD166",
    "red": "#FF8585",
    "teal-soft": "rgba(57,255,20,.1)",
    "blue-soft": "rgba(139,183,255,.14)",
    "amber-soft": "rgba(255,209,102,.14)",
    "red-soft": "rgba(255,107,107,.14)",
    "agent-surface": "var(--background-pane)",
    "agent-overlay": "var(--background-pane)",
    "agent-secondary": "var(--text-accent)",
    "agent-paper": "var(--background-pane)",
    "agent-ink": "var(--text-main)",
    "agent-paper-muted": "var(--text-muted)",
    "agent-paper-line": "var(--line-soft)",
    "agent-paper-margin": "var(--line-soft)",
    "agent-mark": "var(--teal-soft)",
    "agent-mark-ink": "var(--text-main)",
    "agent-machine": "var(--accent-green)",
    "agent-machine-trim": "#3A5646",
    "agent-key": "var(--accent-green)",
    "agent-key-ink": "var(--text-inverse)",
    "agent-stamp": "var(--text-accent)",
    "agent-machine-ink": "var(--text-inverse)",
    "agent-control-line": "var(--border-color-heavy)"
  }
}
