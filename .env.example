# Do NOT commit real secrets. Copy to `.env` and fill in.
#
# Gemini API key created in Google AI Studio (aistudio.google.com).
# GEMINI_API_KEY="replace-me"
#
# Optional:
# HEDGELING_EFFICIENT_GEMINI_MODEL="gemini-3.5-flash-lite"
# Optional Business/Enterprise Gemini frontier model. A matching immutable
# active AI-credit rate must exist before the model can be used.
# HEDGELING_FRONTIER_GEMINI_MODEL="gemini-3.5-pro"
# Legacy alias for the efficient model:
# HEDGELING_GEMINI_MODEL="gemini-3.5-flash-lite"

# Hosted console: named Cognito identities only. Basic/hybrid modes are removed.
# HEDGELING_AUTH_MODE="cognito"
# Agent console is opt-in. Keep its provider key on the server.
# HEDGELING_AGENT_ENABLED="true"
# HEDGELING_AGENT_ORG_CREATION_ENABLED="true"
# HEDGELING_AGENT_PROVIDER="gemini"
# HEDGELING_AGENT_GEMINI_MODEL="your-tested-model-id"
# Local deterministic preview: npm -w @hedgeling/web-console run dev:agent
# CLI/MCP/CI use a project-scoped service-account credential.
# HEDGELING_CONSOLE_URL="https://console.example.com"
# HEDGELING_CONSOLE_TOKEN="replace-with-scoped-service-account-token"
# COGNITO_USER_POOL_ID="us-east-1_example"
# COGNITO_REGION="us-east-1"
# COGNITO_APP_CLIENT_ID="replace-me"
# COGNITO_USERINFO_URL="https://your-domain.auth.us-east-1.amazoncognito.com/oauth2/userInfo"
# HEDGELING_COGNITO_SUPER_ADMIN_GROUP="hedgeling-platform-super-admin"
# HEDGELING_COGNITO_PAYMENT_OPERATIONS_VIEW_GROUP="hedgeling-payment-operations-view"
# HEDGELING_COGNITO_PAYMENT_OPERATIONS_MANAGE_GROUP="hedgeling-payment-operations-manage"
# COGNITO_DOMAIN="your-domain.auth.us-east-1.amazoncognito.com"
# COGNITO_SSO_REDIRECT_URI="https://console.example.com/api/auth/sso/callback"
# HEDGELING_SESSION_SIGNING_SECRET="replace-with-a-high-entropy-secret"
# Exact external origin used for browser mutation checks. Required in
# production; local development may derive it from the request.
# HEDGELING_PUBLIC_ORIGIN="https://console.example.com"
# Exact proxy-hop count. Production warns when this is unset or 0 because
# clients behind a load balancer may otherwise share one rate-limit key.
# HEDGELING_TRUST_PROXY_HOPS="1"
# The Cognito app client must be public (no client secret) and enable
# ALLOW_USER_PASSWORD_AUTH for the custom Hedgeling login form.
#
# Customer self-service signup. Agencies and individual vendors remain
# invitation-only. Production requires the current legal HTTPS URLs.
# HEDGELING_SELF_SERVICE_SIGNUP_ENABLED="true"
# HEDGELING_SELF_SERVICE_TRIAL_DAYS="14"
# HEDGELING_TERMS_VERSION="2026-07-30"
# HEDGELING_PRIVACY_VERSION="2026-07-30"
# HEDGELING_TERMS_URL="https://www.example.com/terms"
# HEDGELING_PRIVACY_URL="https://www.example.com/privacy"
# Ed25519 PKCS8 private key as PEM (escaped newlines accepted) or base64 DER.
# HEDGELING_LEASE_SIGNING_PRIVATE_KEY="replace-me"
# HEDGELING_LEASE_SIGNING_KEY_ID="launch-2026-07"
# HEDGELING_LEASE_TTL_HOURS="24"
# Customer-confirmed project/account deletion uses an export-only grace window,
# followed by the separately scheduled purge worker.
# HEDGELING_DATA_EXPORT_GRACE_DAYS="30"
# Automatic retries stop at this count and require an audited platform retry.
# HEDGELING_DATA_LIFECYCLE_MAX_ATTEMPTS="24"
# HEDGELING_DATA_LIFECYCLE_BATCH_SIZE="10"
#
# Local troubleshooting: set DATABASE_URL to a disposable local database, then
# run npm -w @hedgeling/web-console run dev:local. No AWS credentials required.
# The command prints an expiring token for a named local user.

# Stripe SaaS billing. Stripe remains disabled unless explicitly enabled.
# HEDGELING_STRIPE_ENABLED="true"
# STRIPE_SECRET_KEY="sk_test_replace-me"
# STRIPE_WEBHOOK_SECRET="whsec_replace-me"
# STRIPE_CHECKOUT_SUCCESS_URL="http://localhost:8080/?billing=success"
# STRIPE_CHECKOUT_CANCEL_URL="http://localhost:8080/?billing=canceled"
# STRIPE_PORTAL_RETURN_URL="http://localhost:8080/"
# HEDGELING_STRIPE_AUTOMATIC_TAX="false"
# HEDGELING_STRIPE_ALLOW_PROMOTION_CODES="false"
# HEDGELING_STRIPE_PAST_DUE_GRACE_DAYS="7"
# HEDGELING_SUBSCRIPTION_PROVISIONING_BATCH_SIZE="10"
# HEDGELING_BILLING_METER_BATCH_SIZE="100"
# Reviewed provider mappings used by billing:configure-self-service.
# STRIPE_PRICE_STARTER_BASE_MONTHLY="price_..."
# STRIPE_PRICE_STARTER_NPM_SEAT_MONTHLY="price_..."
# STRIPE_PRICE_BUSINESS_BASE_ANNUAL="price_..."
# STRIPE_PRICE_BUSINESS_AI_CREDIT_MONTHLY="price_..."
# STRIPE_PRICE_BUSINESS_MANAGED_STRING_MONTHLY="price_..."
# STRIPE_PRICE_BUSINESS_NPM_SEAT_MONTHLY="price_..."
# STRIPE_METER_AI_CREDIT_EVENT_NAME="hedgeling_ai_credits"
# STRIPE_METER_MANAGED_STRING_EVENT_NAME="hedgeling_managed_strings"
# STRIPE_METER_NPM_SEAT_EVENT_NAME="hedgeling_npm_seats"
#
# Private npm membership provisioning. The customer team must be a dedicated
# read-only package team, never the default developers team.
# HEDGELING_NPM_ORGANIZATION="your-private-organization"
# HEDGELING_NPM_CUSTOMER_TEAM="your-private-organization:customer-readers"
# HEDGELING_NPM_PACKAGE="@hedgeling/i18n"
# HEDGELING_NPM_REGISTRY="https://registry.npmjs.org/"
# HEDGELING_NPM_TOKEN="replace-me"
# HEDGELING_NPM_PROVISIONING_BATCH_SIZE="10"
#
# Package-enabled trials download an immutable npm .tgz from private S3
# through an audited, short-lived presigned GET. Paid package access continues
# through private npm membership.
# HEDGELING_TRIAL_PACKAGE_DOWNLOAD_ENABLED="true"
# HEDGELING_TRIAL_PACKAGE_BUCKET="your-private-artifact-bucket"
# HEDGELING_TRIAL_PACKAGE_KEY="trial-packages/i18n/0.1.0/hedgeling-i18n-0.1.0.tgz"
# HEDGELING_TRIAL_PACKAGE_VERSION="0.1.0"
# HEDGELING_TRIAL_PACKAGE_FILENAME="hedgeling-i18n-0.1.0.tgz"
# HEDGELING_TRIAL_PACKAGE_SHA256="replace-with-lowercase-sha256"
# HEDGELING_TRIAL_PACKAGE_DOWNLOAD_TTL_SECONDS="600"
# HEDGELING_TRIAL_PACKAGE_DOWNLOADS_PER_HOUR="10"

# Stripe Connect facilitated payments. All movement switches remain
# independently fail-closed until certification and operational approval.
# HEDGELING_FACILITATED_PAYMENTS_ENABLED="true"
# HEDGELING_FACILITATED_PAYMENTS_MODE="test"
# STRIPE_CONNECT_SECRET_KEY="sk_test_replace-me"
# STRIPE_CONNECT_WEBHOOK_SECRET="whsec_replace-me"
# STRIPE_CONNECT_ONBOARDING_RETURN_URL="http://localhost:8080/"
# STRIPE_CONNECT_ONBOARDING_REFRESH_URL="http://localhost:8080/"
# STRIPE_VENDOR_PAYMENT_SUCCESS_URL="http://localhost:8080/?vendorPayment=success"
# STRIPE_VENDOR_PAYMENT_CANCEL_URL="http://localhost:8080/?vendorPayment=cancel"
# HEDGELING_FACILITATED_COLLECTION_ENABLED="false"
# HEDGELING_FACILITATED_TRANSFERS_ENABLED="false"
# HEDGELING_FACILITATED_REFUNDS_ENABLED="false"
# HEDGELING_FACILITATED_LIVE_APPROVED="false"
# HEDGELING_ACH_TRANSFER_HOLD_DAYS="7"
#
# Payout reconciliation revisits recent paid payouts through the return-risk
# window and uses durable, leased, per-connected-account checkpoints.
# HEDGELING_PAYOUT_RECONCILIATION_RETURN_RISK_DAYS="14"
# HEDGELING_PAYOUT_RECONCILIATION_MAX_PAGES="5"
# HEDGELING_PAYOUT_RECONCILIATION_PAGE_SIZE="100"
# HEDGELING_PAYOUT_RECONCILIATION_MAX_LAG_MINUTES="60"
# HEDGELING_PAYOUT_RECONCILIATION_LEASE_MINUTES="15"
# HEDGELING_PROVIDER_EVENT_REPLAY_LEASE_MINUTES="15"
